{
  "name": "homi",
  "version": "1.9.0",
  "private": true,
  "description": "A private home maintenance journal for everything your home needs.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage --ignore-pattern work",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "notifications:process": "tsx scripts/process-reminders.ts",
    "push:keys": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/s3-request-presigner": "^3.848.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^21.0.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.6",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "type": "module"
}
