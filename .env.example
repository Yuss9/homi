# Public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Homi
NEXT_PUBLIC_SUPPORT_EMAIL=support@homi.local

# Database and authentication (replace every secret before production)
DATABASE_URL=postgresql://homi:change-me@postgres:5432/homi
# Host-side CLI URL used by `bun run db:seed` with the full Compose stack.
SEED_DATABASE_URL=postgresql://homi:change-me@127.0.0.1:5432/homi
DATABASE_SSL=false
POSTGRES_DB=homi
POSTGRES_USER=homi
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Email (Mailpit defaults for local Docker)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Homi <no-reply@homi.local>
SUPPORT_EMAIL=support@homi.local

# Private file storage: local or s3
STORAGE_PROVIDER=s3
LOCAL_STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=homi-private
S3_ACCESS_KEY_ID=homi-minio
S3_SECRET_ACCESS_KEY=replace-this-minio-secret
S3_FORCE_PATH_STYLE=true
# Set to AES256 when the S3 provider has server-side encryption configured.
S3_SERVER_SIDE_ENCRYPTION=
MINIO_ROOT_USER=homi-minio
MINIO_ROOT_PASSWORD=replace-this-minio-secret

# Optional Redis rate limiting. Leave REDIS_URL empty to use in-memory limiting.
REDIS_URL=redis://redis:6379

# Optional Google sign-in. Provide both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jobs and operations
CRON_SECRET=replace-with-a-long-random-cron-secret
LOG_LEVEL=info
