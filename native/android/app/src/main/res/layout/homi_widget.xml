<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homi_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/homi_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/homi_widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⌂ Homi"
        android:textColor="#1D6A4E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/homi_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Next maintenance"
        android:textColor="#66736E"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/homi_widget_value"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="Ventilation filter"
        android:textColor="#18201D"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/homi_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Tomorrow"
        android:textColor="#66736E"
        android:textSize="11sp" />
</LinearLayout>
