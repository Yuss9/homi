<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Homi widget"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/homi_widget_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="https://homi.example.com"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/homi_widget_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="widgets:read API key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/homi_widget_home_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Homi home ID"
            android:inputType="text" />

        <Spinner
            android:id="@+id/homi_widget_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/homi_widget_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save widget" />
    </LinearLayout>
</ScrollView>
